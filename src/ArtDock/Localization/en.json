    "Settings.Behaviour.Title": "Behaviour",
    "Settings.Behaviour.AlwaysOnTop": "Always on top",
    "Settings.Behaviour.AlwaysOnTop.Hint": "Keeps the dock above other windows — except a window in front that is maximized or fullscreen on the dock's screen: then the dock slides away, and comes back when the pointer reaches the bottom of the screen under it. Turned off, it can be covered like any other window, and holding the pointer against the bottom edge under it brings it to the front until you move away.",
    "Settings.Behaviour.AutoHide": "Hide the dock until needed",
    "Settings.Behaviour.AutoHide.Hint": "The dock slides away, and returns when the pointer reaches the bottom of the screen under it. It does this anyway while a maximized or fullscreen window is in front.",
    "Settings.Behaviour.HideDelay": "Hide delay",
    "Settings.Behaviour.HideDelay.Hint": "How long after the pointer leaves the dock before auto-hide slides it away, or a dock brought to the front goes back behind the window it was under.",
    "Settings.Behaviour.HideDelay.Value": "{0:0} ms",
    "Settings.Behaviour.RevealDelay": "Reveal delay",
    "Settings.Behaviour.RevealDelay.Hint": "How long the pointer must be held against the bottom edge under the dock before a hidden dock returns or a covered one comes to the front, so brushing past does neither.",
    "Settings.Behaviour.RevealDelay.Value": "{0:0} ms",
    "Settings.Behaviour.Handle": "Show a handle while hidden",
    "Settings.Behaviour.Handle.Hint": "A slim bar just above the taskbar marks where the dock is while you cannot see it — slid away, or under other windows. It is only a mark: hold the pointer against the bottom edge under the dock to bring it up. It shows the colours behind it reversed, so it stands out on any background, and screenshots and recordings leave it out. It is not shown over anything fullscreen, such as a video or a game.",
    "Settings.Behaviour.HandleMatchesDock": "As wide as the dock",
    "Settings.Behaviour.HandleMatchesDock.Hint": "Follows the dock as icons come and go. Turn off to give the handle a width of its own.",
    "Settings.Behaviour.HandleWidth": "Handle width",
    "Settings.Behaviour.HandleWidth.Value": "{0:0} px",
    "Settings.Behaviour.Reset": "Reset Behaviour to defaults",

