<Window
    x:Class="ArtDock.Views.EditPinWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{DynamicResource EditItem.Title}"
    FlowDirection="{DynamicResource Language.FlowDirection}"
    Language="{DynamicResource Language.Tag}"
    Icon="/Assets/ArtDock.ico"
    Width="600"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="CenterScreen">

    <!-- Styled by WPF's own Fluent theme, set in App.xaml. Nothing here paints a colour of
         its own; the few keys referenced are the system's. -->

    <Window.Resources>
        <!-- TextBlock is not a Control: nothing in any theme sets its Foreground, and its
             own default is literally black. Every text style here therefore starts from one
             that names the system's own text brush, and the implicit style below catches
             the plain ones. Leaving that out is what put black text on a dark window. -->
        <Style x:Key="TextBase" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}" />

        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Padding="0,0,10,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Name -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource EditItem.Name}" />
                        <TextBox x:Name="NameBox" Grid.Column="1" VerticalAlignment="Center" />

                        <!-- Puts back the name the item would be given if it were pinned now,
                             which its tooltip shows. Greyed while that is the name already. -->
                        <Button
                            x:Name="ResetNameButton"
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            AutomationProperties.Name="{DynamicResource EditItem.ResetName.Name}"
                            Content="{DynamicResource EditItem.ResetName}" />
                    </Grid>
                </Border>

                <!-- Icon -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Margin="0,6,0,0"
                            VerticalAlignment="Top"
                            Text="{DynamicResource EditItem.Icon}" />

                        <Border
                            Grid.Column="1"
                            Width="76"
                            Height="76"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <!-- Every icon here is shrunk to fit, from 128 px, and the default
                                 linear filter does that by skipping pixels: edges come out in steps. -->
                            <Image
                                x:Name="IconPreview"
                                Width="54"
                                Height="54"
                                RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <!-- Three ways to have the icon, each undoing the others: an image, the
                             folder the dock draws, and the item's own. -->
                        <StackPanel
                            Grid.Column="2"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BrowseButton" Content="{DynamicResource EditItem.ChooseImage}" />

                                <!-- Only for a folder. Pressed, it draws the folder and opens its
                                     colour and symbol under it; pressed again, it closes them. -->
                                <ToggleButton
                                    x:Name="CustomizeButton"
                                    Margin="8,0,0,0"
                                    Content="{DynamicResource EditItem.Customize}"
                                    Visibility="Collapsed" />
                            </StackPanel>
                            <Button x:Name="ResetIconButton" Margin="0,8,0,0" Content="{DynamicResource EditItem.UseOwnIcon}" />
                            <TextBlock
                                x:Name="IconPathText"
                                Margin="2,8,0,0"
                                Style="{StaticResource Hint}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Only for a picture, which is all that has a thumbnail to turn down. -->
                        <CheckBox
                            x:Name="UseIconBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,12,0,0"
                            Content="{DynamicResource EditItem.UseIconNotThumbnail}"
                            Visibility="Collapsed" />

                        <!-- The drawn folder's colour and symbol, under the button that opens them. -->
                        <Grid
                            x:Name="CustomizePanel"
                            Grid.Row="2"
                            Grid.ColumnSpan="3"
                            Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Margin="0,18,0,0"
                                VerticalAlignment="Top"
                                Text="{DynamicResource EditItem.Folder.Colour}" />

                            <!-- The wheel is added in code: it is a drawn control, not a template. -->
                            <ContentControl
                                x:Name="FolderWheelHost"
                                Grid.Column="1"
                                Margin="0,18,0,0"
                                VerticalAlignment="Top" />

                            <StackPanel
                                Grid.Column="2"
                                Margin="16,18,0,0"
                                VerticalAlignment="Top">
                                <WrapPanel x:Name="FolderSwatchPanel" />

                                <!-- The colour in hex, kept in step with the wheel and the swatches. -->
                                <TextBox
                                    x:Name="FolderHexBox"
                                    Width="110"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="{DynamicResource EditItem.Folder.Hex}"
                                    ToolTip="{DynamicResource EditItem.Folder.Hex}" />
                            </StackPanel>

                            <TextBlock
                                Grid.Row="1"
                                Margin="0,20,0,0"
                                VerticalAlignment="Top"
                                Text="{DynamicResource EditItem.Folder.Symbol}" />

                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Margin="0,18,0,0">
                                <!-- What the symbol, or the text, is painted in. -->
                                <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                    <RadioButton
                                        x:Name="ToneTonedButton"
                                        GroupName="SymbolTone"
                                        Content="{DynamicResource EditItem.Folder.Tone.Toned}" />
                                    <RadioButton
                                        x:Name="ToneWhiteButton"
                                        GroupName="SymbolTone"
                                        Content="{DynamicResource EditItem.Folder.Tone.White}" />
                                    <RadioButton
                                        x:Name="ToneBlackButton"
                                        GroupName="SymbolTone"
                                        Content="{DynamicResource EditItem.Folder.Tone.Black}" />
                                </StackPanel>

                                <!-- Tiles small enough for three rows of them, so the dialog fits a
                                     laptop's screen without scrolling while this is open. -->
                                <WrapPanel x:Name="SymbolPanel" />
                            </StackPanel>

                            <TextBlock
                                Grid.Row="2"
                                Margin="0,20,0,0"
                                VerticalAlignment="Top"
                                Text="{DynamicResource EditItem.Folder.Text}" />

                            <!-- A few letters in place of a symbol. -->
                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Margin="0,14,0,0"
                                Orientation="Horizontal">
                                <TextBox
                                    x:Name="FolderTextBox"
                                    Width="110"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{DynamicResource EditItem.Folder.Text}" />
                                <TextBlock
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Hint}"
                                    Text="{DynamicResource EditItem.Folder.Text.Hint}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- What it opens -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource EditItem.Opens}" />
                            <TextBox x:Name="TargetBox" Grid.Column="1" VerticalAlignment="Center" />
                            <Button
                                x:Name="BrowseTargetButton"
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                Content="{DynamicResource Common.Browse}" />
                        </Grid>
                        <TextBlock
                            Margin="80,8,0,0"
                            Style="{StaticResource Hint}"
                            Text="{DynamicResource EditItem.Opens.Hint}" />
                    </StackPanel>
                </Border>

                <!-- The label's lettering is not here: it is the whole dock's, and is set on
                     the settings dialog's Icons page. The hint says where, for anyone who
                     comes looking for it in the place it used to be. -->
                <TextBlock
                    Margin="2,12,0,0"
                    Style="{StaticResource Hint}"
                    Text="{DynamicResource EditItem.Hint}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="1"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="CancelButton"
                Margin="0,0,8,0"
                MinWidth="96"
                Content="{DynamicResource Common.Cancel}"
                IsCancel="True" />
            <Button
                x:Name="SaveButton"
                MinWidth="96"
                Content="{DynamicResource Common.Save}"
                IsDefault="True"
                Style="{DynamicResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
