<Window
    x:Class="ArtDock.Views.ScanWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:ArtDock.Views"
    Title="{DynamicResource Scan.Title}"
    FlowDirection="{DynamicResource Language.FlowDirection}"
    Language="{DynamicResource Language.Tag}"
    Icon="/Assets/ArtDock.ico"
    Width="680"
    Height="700"
    MinWidth="500"
    MinHeight="440"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="CenterOwner">

    <!-- Styled by WPF's own Fluent theme, like the other dialogs. Opened from the settings
         dialog's Exclusions page and its Add menu, over it, and from the dock's Add menu,
         which gives it no owner and so has it centred on the screen instead. -->

    <Window.Resources>
        <!-- TextBlock is not a Control, and its own default foreground is black; see the
             settings dialog for the whole story. -->
        <Style x:Key="TextBase" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}" />

        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!-- A small label beside a program's name. -->
        <Style x:Key="Tag" TargetType="Border">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="6,0,6,1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <BooleanToVisibilityConverter x:Key="Shown" />

        <!-- A game: ticking it ticks every program in it, which is the answer for anyone who
             knows the game and not its programs. Shows a dash while only some are ticked. -->
        <DataTemplate DataType="{x:Type views:ScanGame}">
            <CheckBox
                Margin="0,10,0,2"
                IsChecked="{Binding IsChecked, Mode=TwoWay}"
                IsEnabled="{Binding CanAdd}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Hint}"
                        TextWrapping="NoWrap"
                        Text="{Binding Source}" />
                </StackPanel>
            </CheckBox>
        </DataTemplate>

        <!-- A program, or the programs in a game that give the same name. Indented under
             its game, when there is one. -->
        <DataTemplate DataType="{x:Type views:ScanRow}">
            <CheckBox
                Margin="{Binding Margin}"
                IsChecked="{Binding IsChecked, Mode=TwoWay}"
                IsEnabled="{Binding CanAdd}"
                ToolTip="{Binding Paths}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Width="28"
                        Height="28"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="{Binding Icon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <Border
                                Style="{StaticResource Tag}"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Visibility="{Binding IsOpen, Converter={StaticResource Shown}}">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="{DynamicResource Scan.OpenNow}" />
                            </Border>
                            <Border
                                Style="{StaticResource Tag}"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                Visibility="{Binding HasListed, Converter={StaticResource Shown}}">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding ListedText}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Files}" />
                    </StackPanel>
                </Grid>
            </CheckBox>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="HeadingText"
            FontSize="16"
            FontWeight="SemiBold"
            TextTrimming="CharacterEllipsis" />

        <!-- Said by the code: games and apps are ticked differently. -->
        <TextBlock
            x:Name="HintText"
            Grid.Row="1"
            Margin="0,4,0,12"
            Style="{StaticResource Hint}" />

        <!-- Filter and order. Greyed until there is something to filter and order. -->
        <Grid
            x:Name="ListTools"
            Grid.Row="2"
            Margin="0,0,0,8"
            IsEnabled="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- WPF's TextBox has no placeholder of its own, so the prompt is laid over it
                 and goes once anything is typed. -->
            <Grid>
                <TextBox x:Name="FilterBox" VerticalContentAlignment="Center" />
                <TextBlock
                    x:Name="FilterPrompt"
                    Margin="12,0,12,0"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Style="{StaticResource Hint}"
                    FontSize="14"
                    TextWrapping="NoWrap"
                    Text="{DynamicResource Scan.Filter}" />
            </Grid>

            <TextBlock
                Grid.Column="1"
                Margin="16,0,8,0"
                VerticalAlignment="Center"
                Text="{DynamicResource Scan.Sort}" />
            <ComboBox
                x:Name="SortBox"
                Grid.Column="2"
                MinWidth="190"
                VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4">
            <Grid>
                <!-- Games and their programs in one list, a heading before each game's rows.
                     An ItemsControl rather than a ListBox: a row is chosen by its tick, and a
                     selection besides would be a second, meaningless kind of chosen. Still
                     virtualised, because a library can hold hundreds of programs. -->
                <ItemsControl
                    x:Name="Results"
                    Padding="12,0,12,8"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    Visibility="Collapsed">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer
                                Padding="{TemplateBinding Padding}"
                                CanContentScroll="True"
                                Focusable="False"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- While looking. Stop keeps what has been found so far. -->
                <StackPanel
                    x:Name="ProgressPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <ProgressBar Width="260" IsIndeterminate="True" />
                    <TextBlock
                        x:Name="ProgressText"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        x:Name="ProgressDetail"
                        Margin="0,2,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource Hint}" />
                    <Button
                        x:Name="StopButton"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        MinWidth="96"
                        Content="{DynamicResource Scan.Stop}" />
                </StackPanel>

                <!-- No libraries, nothing found, or nothing matching the filter. -->
                <TextBlock
                    x:Name="MessageText"
                    Margin="12,10,12,10"
                    VerticalAlignment="Top"
                    Style="{StaticResource Hint}"
                    Visibility="Collapsed" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Margin="2,10,0,0">
            <TextBlock
                x:Name="StoppedText"
                Margin="0,6,0,0"
                Style="{StaticResource Hint}"
                Text="{DynamicResource Scan.Stopped}"
                Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- For a game the launchers do not know about, or one of the user's own. -->
            <Button
                x:Name="AddFolderButton"
                MinWidth="96"
                IsEnabled="False"
                Content="{DynamicResource Scan.AddFolder}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button
                    x:Name="CancelButton"
                    Margin="0,0,8,0"
                    MinWidth="96"
                    IsCancel="True"
                    Content="{DynamicResource Common.Cancel}" />
                <Button
                    x:Name="AddButton"
                    MinWidth="96"
                    IsDefault="True"
                    IsEnabled="False"
                    Style="{DynamicResource AccentButtonStyle}"
                    Content="{DynamicResource Scan.Add}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
