<Window
    x:Class="ArtDock.Views.ConfirmEndTaskWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ArtDock"
    FlowDirection="{DynamicResource Language.FlowDirection}"
    Language="{DynamicResource Language.Tag}"
    Icon="/Assets/ArtDock.ico"
    Width="460"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="CenterScreen">

    <!-- Styled by WPF's own Fluent theme, set in App.xaml, like the other dialogs. -->

    <Window.Resources>
        <!-- TextBlock is not a Control, and its own default foreground is black; see the
             same style in EditPinWindow. -->
        <Style x:Key="TextBase" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}" />

    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The item's own icon, so the question is about something you can see. -->
        <Image
            x:Name="IconImage"
            Grid.RowSpan="2"
            Width="48"
            Height="48"
            Margin="0,2,16,0"
            VerticalAlignment="Top" />

        <TextBlock
            x:Name="HeadingText"
            Grid.Column="1"
            FontSize="20"
            FontWeight="SemiBold"
            TextWrapping="Wrap" />

        <TextBlock
            x:Name="DetailText"
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,8,0,0"
            Text="{DynamicResource EndTask.Detail}"
            TextWrapping="Wrap" />

        <!-- Cancel is the default, and has the focus, so Enter leaves the app running: ending
             it loses whatever it has not saved, and a keystroke meant for something else is one
             of the ways that would happen. Cancel first and the act on the right, as in the
             other dialogs. Not in the critical colour, which this app keeps for taking an item
             off the dock. -->
        <StackPanel
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Margin="0,24,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="CancelButton"
                Margin="0,0,8,0"
                MinWidth="96"
                Content="{DynamicResource Common.Cancel}"
                IsCancel="True"
                IsDefault="True" />
            <Button
                x:Name="EndButton"
                MinWidth="96"
                Content="{DynamicResource EndTask.Confirm}" />
        </StackPanel>
    </Grid>
</Window>
