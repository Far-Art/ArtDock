<Window
    x:Class="ArtDock.Views.ConfirmRemoveWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ArtDock"
    FlowDirection="{DynamicResource Language.FlowDirection}"
    Language="{DynamicResource Language.Tag}"
    Icon="/Assets/ArtDock.ico"
    Width="460"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="CenterScreen">

    <!-- Styled by WPF's own Fluent theme, set in App.xaml, like the other dialogs. -->

    <Window.Resources>
        <!-- TextBlock is not a Control, and its own default foreground is black; see the
             same style in EditPinWindow. -->
        <Style x:Key="TextBase" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}" />

        <!-- The settings dialog's DangerButton: Remove there and Remove here are the same act,
             and the dock's menu entry that led here is in the same colour. -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The item's own icon, so the question is about something you can see. Collapsed
             for a separator, which has none. -->
        <Image
            x:Name="IconImage"
            Grid.RowSpan="2"
            Width="48"
            Height="48"
            Margin="0,2,16,0"
            VerticalAlignment="Top" />

        <TextBlock
            x:Name="HeadingText"
            Grid.Column="1"
            FontSize="20"
            FontWeight="SemiBold"
            TextWrapping="Wrap" />

        <TextBlock
            x:Name="DetailText"
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,8,0,0"
            Text="{DynamicResource RemoveItem.Detail}"
            TextWrapping="Wrap" />

        <!-- Cancel is the default, and has the focus, so Enter keeps the icon. The point of
             asking is that a pin does not go by accident, and a keystroke meant for something
             else is one of the ways it would. Cancel first and the act on the right, as in the
             other dialogs. -->
        <StackPanel
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Margin="0,24,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="CancelButton"
                Margin="0,0,8,0"
                MinWidth="96"
                Content="{DynamicResource Common.Cancel}"
                IsCancel="True"
                IsDefault="True" />
            <Button
                x:Name="RemoveButton"
                MinWidth="96"
                Content="{DynamicResource Common.Remove}"
                Style="{StaticResource DangerButton}" />
        </StackPanel>
    </Grid>
</Window>
