<Window
    x:Class="ArtDock.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ArtDock.Controls"
    xmlns:loc="clr-namespace:ArtDock.Localization"
    xmlns:views="clr-namespace:ArtDock.Views"
    Title="{DynamicResource Settings.Title}"
    FlowDirection="{DynamicResource Language.FlowDirection}"
    Language="{DynamicResource Language.Tag}"
    Icon="/Assets/ArtDock.ico"
    Width="900"
    Height="780"
    MinWidth="640"
    MinHeight="480"
    ResizeMode="CanResize"
    Topmost="True"
    WindowStartupLocation="CenterScreen">

    <!-- Everything here is WPF's own Fluent theme (App.xaml's ThemeMode), so the controls
         are Windows 11 controls rather than an imitation of them, and the colours below are
         the system's own resource keys rather than hex this project invented. Nothing is
         hard-coded except spacing. -->

    <Window.Resources>
        <!-- TextBlock is not a Control: nothing in any theme sets its Foreground, and its
             own default is literally black. Every text style here therefore starts from one
             that names the system's own text brush, and the implicit style below catches
             the plain ones. Leaving that out is what put black text on a dark window. -->
        <Style x:Key="TextBase" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}" />

        <views:ItemRowIconConverter x:Key="ItemRowIcon" />
        <views:FolderRowMarkConverter x:Key="FolderRowMark" />

        <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="GroupHeader" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,16,0,6" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardHint" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- The Settings app's row: a rounded, faintly outlined panel per setting. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Style.Triggers>
                <!-- A card that does not apply dims as a whole. The controls inside grey
                     themselves, but their labels are TextBlocks and would otherwise stay at
                     full strength next to a slider nothing is listening to. -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Each page ends with its own reset. Deliberately on the page rather than in the
             window's button row: a reset button is only unambiguous when what it covers is
             the thing it is sitting at the foot of. -->
        <Style x:Key="PageReset" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="MinWidth" Value="190" />
        </Style>

        <!-- The grip on a pinned row. Drawn rather than a glyph: the icon fonts that carry
             one are not guaranteed to be installed, and a missing glyph renders as a box —
             which is worse than no affordance at all. Six squares in two columns is the
             shape everyone reads as "pick this up". -->
        <Geometry x:Key="GripDots">
            M0,0H2V2H0Z M4,0H6V2H4Z M0,4H2V6H0Z M4,4H6V6H4Z M0,8H2V10H0Z M4,8H6V10H4Z
        </Geometry>

        <!-- The buttons that take something away — Remove on both list pages, Clear all, and
             the whole-application reset — coloured so they do not read like the ones beside
             them that do not. -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>

        <!-- A button with its command's glyph before its words, named on the button with
             views:MenuIcons.Glyph — the glyph the dock's menus draw beside the same command, so
             Remove looks like Remove from dock. Set to the left, so the glyphs of a column of
             buttons stand in a line, and stretched to the column, which is as wide as the widest
             of them: the theme sizes a button to its content, and a glyph took Item settings…
             past the others' width. Neither glyph nor words is given a colour: both take the
             button's, which is the critical colour on a danger button, and greys with it. -->
        <Style x:Key="GlyphButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Text="{Binding (views:MenuIcons.Glyph), RelativeSource={RelativeSource AncestorType=Button}, Converter={x:Static views:MenuIcons.CodePointOf}}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DangerButton's colour on GlyphButton's layout. -->
        <Style x:Key="DangerGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The Hotkeys page's rows: a box that records a hotkey (Controls/HotkeyRecorder), with
             an × in it that empties it, as Windows' own text boxes have, and a line under it
             saying what is wrong with what the box holds — in Windows' caution colour, as the
             Language card's problems are, and only when there is something to say. -->
        <Style x:Key="HotkeyField" TargetType="Grid">
            <Setter Property="Width" Value="200" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The theme's padding, 10,5,6,6, with room on the right for the ×. -->
        <Style x:Key="HotkeyBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="10,5,32,6" />
        </Style>

        <!-- The ×, over the box's right end: there only while the box holds something — the code
             greys it otherwise, and greyed it goes — and no tab stop, nor anything that takes the
             keyboard from a box that is recording; Backspace and Delete in the box empty it from
             the keyboard. Named for a screen reader, which can still press it. -->
        <Style x:Key="HotkeyClear" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Content" Value="&#xE894;" />
            <Setter Property="ToolTip" Value="{DynamicResource Settings.Hotkeys.Clear}" />
            <Setter Property="AutomationProperties.Name" Value="{DynamicResource Settings.Hotkeys.Clear}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HotkeyStatus" TargetType="TextBlock" BasedOn="{StaticResource CardHint}">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <!-- An item's two keys share its row: each is a box with its own status line under it,
             as wide as the boxes above, so the headings line up with them. Where the page is too
             narrow for both, the second goes under the first: the row's WrapPanel does it, and
             the headings, made the same way, wrap with it. The gap between the two is a margin on
             the left of both, which the panel takes back with one of its own: a margin on the
             second alone would go with it when it wraps, and stand it out from under the first.
             The space under each is what keeps two boxes apart when one is under the other. -->
        <Style x:Key="PlaceKey" TargetType="StackPanel">
            <Setter Property="Width" Value="200" />
            <Setter Property="Margin" Value="16,0,0,4" />
        </Style>

        <Style x:Key="PlaceHeading" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Width" Value="200" />
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>

        <!-- A place's checkbox, which turns that item's keys on and off by themselves, as quick
             launch turns all of them: named by the place, with the icon of the item in that place
             before the name when there is one. At the top of its row, level with the boxes, rather
             than halfway down the boxes and their status lines together; and no wider than what it
             holds, where the theme makes every checkbox at least 120 wide — on a narrow dialog the
             room is the boxes'. -->
        <Style x:Key="PlaceCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="ToolTip" Value="{DynamicResource Settings.Hotkeys.Place.Hint}" />
            <Setter Property="AutomationProperties.HelpText" Value="{DynamicResource Settings.Hotkeys.Place.Hint}" />
        </Style>

        <!-- The icon the dock draws the item with, as the Items page shows it — shrunk from 128,
             so high quality, or its edges come out in steps. Its room is kept where there is no
             item, so the names stand in line. -->
        <Style x:Key="PlaceIcon" TargetType="Image">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        </Style>

        <!-- The column the value beside every slider sits in, one width for all of them so
             the sliders line up down a page. Sized for the longest read-out there is rather
             than for English: "100% right" set the width first, and a translated "3 icons" is
             routinely longer than the English — German's is "3 Symbole". -->
        <GridLength x:Key="ReadoutWidth">80</GridLength>

        <Style x:Key="RowValue" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- BasedOn matters: the Fluent theme supplies its controls as implicit styles, and
             an explicit style without a base replaces one outright rather than adding to it
             — which is how these sliders lost their Windows 11 template and came back as
             the old grey ones. -->
        <Style x:Key="RowSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="Margin" Value="12,0,12,0" />
        </Style>

        <!-- Left navigation, the way the Settings app arranges its pages. A TabControl
             rather than a bespoke list, so the pages stay pages and the code-behind does
             not have to know the difference. -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <!-- For the same reason as TabItem below: this replaces the theme's style, so
                 anything in a page that falls back to inherited text colour would fall back
                 to black. Nothing does today; this is so nothing added later can. -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="188" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel IsItemsHost="True" Margin="0,4,0,0" />

                            <!-- Named as the theme's own template names it, and not for looks:
                                 UI Automation finds a page's contents through the TabControl's
                                 PART_SelectedContentHost. Unnamed, a screen reader could reach the
                                 page names and not one setting on any page. -->
                            <ContentPresenter
                                x:Name="PART_SelectedContentHost"
                                Grid.Column="1"
                                Margin="20,0,0,0"
                                ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <!-- The header text is a TextBlock the ContentPresenter makes for itself inside
                 the template, so no implicit style reaches it. What it does inherit is
                 Foreground, and this style replaces the theme's — which left it on Control's
                 default of black, invisible against a dark window. Naming the system's text
                 brush here is what the generated TextBlock picks up. -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border
                            x:Name="Chrome"
                            Margin="0,1,8,1"
                            Padding="10,9"
                            Background="Transparent"
                            CornerRadius="4">
                            <Grid>
                                <!-- The accent bar down the left of the selected page. -->
                                <Border
                                    x:Name="Indicator"
                                    Width="3"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="2"
                                    Opacity="0" />
                                <ContentPresenter
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    ContentSource="Header" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,12,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs">

            <!-- ==================== SIZE AND MOTION ==================== -->
            <TabItem x:Name="SizePage" Header="{DynamicResource Settings.Page.Size}">
                <ScrollViewer Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Settings.Size.Title}" />

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="{StaticResource ReadoutWidth}" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource Settings.Size.IconSize}" />
                                <Slider
                                    x:Name="BaseSizeSlider"
                                    AutomationProperties.Name="{DynamicResource Settings.Size.IconSize}"
                                    Grid.Column="1"
                                    Style="{StaticResource RowSlider}"
                                    Maximum="96"
                                    Minimum="20"
                                    TickFrequency="1" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource RowValue}"
                                    loc:Localized.Key="Settings.Size.IconSize.Value"
                                    loc:Localized.Value="{Binding ElementName=BaseSizeSlider, Path=Value}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="{StaticResource ReadoutWidth}" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource Settings.Size.Magnification}" />
                                <Slider
                                    x:Name="MaxScaleSlider"
                                    AutomationProperties.Name="{DynamicResource Settings.Size.Magnification}"
                                    Grid.Column="1"
                                    Style="{StaticResource RowSlider}"
                                    Maximum="2.5"
                                    Minimum="1"
                                    TickFrequency="0.05" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource RowValue}"
                                    loc:Localized.Key="Settings.Size.Magnification.Value"
                                    loc:Localized.Value="{Binding ElementName=MaxScaleSlider, Path=Value}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="{StaticResource ReadoutWidth}" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Settings.Size.Influence}" />
                                    <TextBlock
                                        Style="{StaticResource CardHint}"
                                        Text="{DynamicResource Settings.Size.Influence.Hint}" />
                                </StackPanel>
                                <Slider
                                    x:Name="InfluenceSlider"
                                    AutomationProperties.Name="{DynamicResource Settings.Size.Influence}"
                                    AutomationProperties.HelpText="{DynamicResource Settings.Size.Influence.Hint}"
                                    Grid.Column="1"
                                    Style="{StaticResource RowSlider}"
                                    Maximum="6"
                                    Minimum="1"
                                    TickFrequency="1" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource RowValue}"
                                    loc:Localized.Key="Settings.Size.Influence.Value"
                                    loc:Localized.Value="{Binding ElementName=InfluenceSlider, Path=Value}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="{StaticResource ReadoutWidth}" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Settings.Size.Gap}" />
                                    <TextBlock
                                        Style="{StaticResource CardHint}"
                                        Text="{DynamicResource Settings.Size.Gap.Hint}" />
                                </StackPanel>
                                <Slider
                                    x:Name="GapSlider"
                                    AutomationProperties.Name="{DynamicResource Settings.Size.Gap}"
                                    AutomationProperties.HelpText="{DynamicResource Settings.Size.Gap.Hint}"
                                    Grid.Column="1"
                                    Style="{StaticResource RowSlider}"
                                    Maximum="0.6"
                                    Minimum="0"
                                    TickFrequency="0.02" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource RowValue}"
                                    loc:Localized.Key="Settings.Size.Gap.Value"
                                    loc:Localized.Value="{Binding ElementName=GapSlider, Path=Value}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Settings.Size.Sweep}" />
                                    <TextBlock
                                        Style="{StaticResource CardHint}"
                                        Text="{DynamicResource Settings.Size.Sweep.Hint}" />
                                </StackPanel>
                                <CheckBox
                                    x:Name="SweepCheck"
                                    AutomationProperties.Name="{DynamicResource Settings.Size.Sweep}"
                                    AutomationProperties.HelpText="{DynamicResource Settings.Size.Sweep.Hint}"
                                    Grid.Column="1"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Button
                            x:Name="ResetSizeButton"
                            Style="{StaticResource PageReset}"
                            Content="{DynamicResource Settings.Size.Reset}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== THE BAR ==================== -->
            <TabItem x:Name="AppearancePage" Header="{DynamicResource Settings.Page.Appearance}">
                <ScrollViewer Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Settings.Appearance.Title}" />

                        <!-- Why the blur's card below is greyed, and what the opacity does now,
                             said at full strength: a note inside the greyed card would be
                             dimmed with it. -->
                        <TextBlock
                            x:Name="NoGpuNote"
                            Margin="2,0,0,8"
                            Style="{StaticResource Hint}"
                            Text="{DynamicResource Settings.Appearance.NoGpu.Note}"
                            Visibility="Collapsed" />

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="{StaticResource ReadoutWidth}" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource Settings.Appearance.Opacity}" />
                                <Slider
                                    x:Name="OpacitySlider"
                                    AutomationProperties.Name="{DynamicResource Settings.Appearance.Opacity}"
                                    Grid.Column="1"
                                    Style="{StaticResource RowSlider}"
                                    Maximum="1"
                                    Minimum="0.2"
                                    TickFrequency="0.02" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource RowValue}"
                                    loc:Localized.Key="Settings.Appearance.Opacity.Value"
                                    loc:Localized.Value="{Binding ElementName=OpacitySlider, Path=Value}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="{StaticResource ReadoutWidth}" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource Settings.Appearance.Roundness}" />
                                <Slider
                                    x:Name="RoundnessSlider"
                                    AutomationProperties.Name="{DynamicResource Settings.Appearance.Roundness}"
                                    Grid.Column="1"
                                    Style="{StaticResource RowSlider}"
                                    Maximum="1"
                                    Minimum="0"
                                    TickFrequency="0.02" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource RowValue}"
                                    loc:Localized.Key="Settings.Appearance.Roundness.Value"
                                    loc:Localized.Value="{Binding ElementName=RoundnessSlider, Path=Value}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource Settings.Appearance.Colour}" />
                                    <TextBox
                                        x:Name="BarColorBox"
                                        AutomationProperties.Name="{DynamicResource Settings.Appearance.Colour}"
                                        Grid.Column="1"
                                        Margin="12,0,12,0"
                                        VerticalAlignment="Center" />
                                    <Border
                                        Grid.Column="2"
                                        Width="52"
                                        Height="28"
                                        VerticalAlignment="Center"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <Border.Background>
                                            <SolidColorBrush x:Name="BarColorPreview" />
                                        </Border.Background>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Settings.Appearance.MatchTaskbar}" />
                                        <TextBlock
                                            Style="{StaticResource CardHint}"
                                            Text="{DynamicResource Settings.Appearance.MatchTaskbar.Hint}" />
                                    </StackPanel>
                                    <CheckBox
                                        x:Name="TaskbarColorCheck"
                                        AutomationProperties.Name="{DynamicResource Settings.Appearance.MatchTaskbar}"
                                        AutomationProperties.HelpText="{DynamicResource Settings.Appearance.MatchTaskbar.Hint}"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <!-- Everything the taskbar option overrides, so it can all be
                                     greyed together rather than one control at a time. -->
                                <Grid x:Name="ManualColorPanel" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- The wheel is added in code: it is a drawn control, not a template. -->
                                    <ContentControl x:Name="WheelHost" VerticalAlignment="Top" />

                                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                        <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Settings.Appearance.Swatches}" />
                                        <WrapPanel x:Name="SwatchPanel" Margin="0,8,0,0" />

                                        <TextBlock
                                            Margin="0,10,0,0"
                                            Style="{StaticResource Hint}"
                                            Text="{DynamicResource Settings.Appearance.SavedColours}" />
                                        <WrapPanel x:Name="CustomSwatchPanel" Margin="0,8,0,0" />
                                        <TextBlock
                                            x:Name="NoSavedColorsHint"
                                            Style="{StaticResource Hint}"
                                            Text="{DynamicResource Settings.Appearance.NoSavedColours}" />
                                        <Button
                                            x:Name="SaveColorButton"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            MinWidth="132"
                                            Content="{DynamicResource Settings.Appearance.SaveColour}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="BlurCard" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Settings.Appearance.Blur}" />
                                    <TextBlock
                                        Style="{StaticResource CardHint}"
                                        Text="{DynamicResource Settings.Appearance.Blur.Hint}" />
                                </StackPanel>
                                <CheckBox
                                    x:Name="BlurCheck"
                                    AutomationProperties.Name="{DynamicResource Settings.Appearance.Blur}"
                                    AutomationProperties.HelpText="{DynamicResource Settings.Appearance.Blur.Hint}"
                                    Grid.Column="1"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Button
                            x:Name="ResetAppearanceButton"
                            Style="{StaticResource PageReset}"
                            Content="{DynamicResource Settings.Appearance.Reset}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== BEHAVIOUR ==================== -->
            <TabItem x:Name="BehaviourPage" Header="{DynamicResource Settings.Page.Behaviour}">
                <ScrollViewer Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Settings.Behaviour.Title}" />

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Settings.Behaviour.AlwaysOnTop}" />
                                    <TextBlock
                                        Style="{StaticResource CardHint}"
                                        Text="{DynamicResource Settings.Behaviour.AlwaysOnTop.Hint}" />
                                </StackPanel>
                                <CheckBox
                                    x:Name="AlwaysOnTopCheck"
                                    AutomationProperties.Name="{DynamicResource Settings.Behaviour.AlwaysOnTop}"
                                    AutomationProperties.HelpText="{DynamicResource Settings.Behaviour.AlwaysOnTop.Hint}"
                                    Grid.Column="1"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Settings.Behaviour.AutoHide}" />
                                    <TextBlock
                                        Style="{StaticResource CardHint}"
                                        Text="{DynamicResource Settings.Behaviour.AutoHide.Hint}" />
                                </StackPanel>
                                <CheckBox
                                    x:Name="AutoHideCheck"
                                    AutomationProperties.Name="{DynamicResource Settings.Behaviour.AutoHide}"
                                    AutomationProperties.HelpText="{DynamicResource Settings.Behaviour.AutoHide.Hint}"
                                    Grid.Column="1"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Never greyed out: with auto-hide off it marks a dock that is under
                             other windows. Its width greys with the handle, and the slider with
                             the match, the way the taskbar colour greys the manual colour. It has
                             no choice of look: it always inverts what is behind it. -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Settings.Behaviour.Handle}" />
                                        <TextBlock
                                            Style="{StaticResource CardHint}"
                                            Text="{DynamicResource Settings.Behaviour.Handle.Hint}" />
                                    </StackPanel>
                                    <CheckBox
                                        x:Name="HandleCheck"
                                        AutomationProperties.Name="{DynamicResource Settings.Behaviour.Handle}"
                                        AutomationProperties.HelpText="{DynamicResource Settings.Behaviour.Handle.Hint}"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel x:Name="HandleOptionsPanel" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Settings.Behaviour.HandleMatchesDock}" />
                                            <TextBlock
                                                Style="{StaticResource CardHint}"
                                                Text="{DynamicResource Settings.Behaviour.HandleMatchesDock.Hint}" />
                                        </StackPanel>
                                        <CheckBox
                                            x:Name="HandleMatchDockCheck"
                                            AutomationProperties.Name="{DynamicResource Settings.Behaviour.HandleMatchesDock}"
                                            AutomationProperties.HelpText="{DynamicResource Settings.Behaviour.HandleMatchesDock.Hint}"
                                            Grid.Column="1"
                                            VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid x:Name="HandleWidthRow" Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="{StaticResource ReadoutWidth}" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource Settings.Behaviour.HandleWidth}" />
                                        <Slider
                                            x:Name="HandleWidthSlider"
                                            AutomationProperties.Name="{DynamicResource Settings.Behaviour.HandleWidth}"
                                            Grid.Column="1"
                                            Style="{StaticResource RowSlider}"
                                            Maximum="600"
                                            Minimum="40"
                                            TickFrequency="10" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{StaticResource RowValue}"
                                            loc:Localized.Key="Settings.Behaviour.HandleWidth.Value"
                                            loc:Localized.Value="{Binding ElementName=HandleWidthSlider, Path=Value}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Never greyed out, like the reveal delay below: with auto-hide off, the
                             same wait sends a dock the edge lifted back under what it covered. -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="{StaticResource ReadoutWidth}" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Settings.Behaviour.HideDelay}" />
                                    <TextBlock
                                        Style="{StaticResource CardHint}"
                                        Text="{DynamicResource Settings.Behaviour.HideDelay.Hint}" />
                                </StackPanel>
                                <Slider
                                    x:Name="HideDelaySlider"
                                    AutomationProperties.Name="{DynamicResource Settings.Behaviour.HideDelay}"
                                    AutomationProperties.HelpText="{DynamicResource Settings.Behaviour.HideDelay.Hint}"
                                    Grid.Column="1"
                                    Style="{StaticResource RowSlider}"
                                    Maximum="3000"
                                    Minimum="0"
                                    TickFrequency="50" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource RowValue}"
                                    loc:Localized.Key="Settings.Behaviour.HideDelay.Value"
                                    loc:Localized.Value="{Binding ElementName=HideDelaySlider, Path=Value}" />
                            </Grid>
                        </Border>

                        <!-- Never greyed out: the same hold against the edge also lifts a covered
                             dock, whatever the other settings are. -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="{StaticResource ReadoutWidth}" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Settings.Behaviour.RevealDelay}" />
                                    <TextBlock
                                        Style="{StaticResource CardHint}"
                                        Text="{DynamicResource Settings.Behaviour.RevealDelay.Hint}" />
                                </StackPanel>
                                <Slider
                                    x:Name="RevealDelaySlider"
                                    AutomationProperties.Name="{DynamicResource Settings.Behaviour.RevealDelay}"
                                    AutomationProperties.HelpText="{DynamicResource Settings.Behaviour.RevealDelay.Hint}"
                                    Grid.Column="1"
                                    Style="{StaticResource RowSlider}"
                                    Maximum="1000"
                                    Minimum="0"
                                    TickFrequency="10" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource RowValue}"
                                    loc:Localized.Key="Settings.Behaviour.RevealDelay.Value"
                                    loc:Localized.Value="{Binding ElementName=RevealDelaySlider, Path=Value}" />
                            </Grid>
                        </Border>

                        <Button
                            x:Name="ResetBehaviourButton"
                            Style="{StaticResource PageReset}"
                            Content="{DynamicResource Settings.Behaviour.Reset}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== ICONS ==================== -->
            <!-- How the icons themselves look, and the labels over them, where Appearance is the
                 bar they stand on. Just before Items, whose rows are drawn from the icon set chosen
                 here. The icon set and the shadow came here from Appearance, and the labels'
                 lettering from the item editor, where it was chosen for one item and written to
                 all of them. Named so the code can tell when it is open: the dock holds
                 an icon up with its label showing while it is, since the lettering is meant to be
                 judged where it is used. -->
            <TabItem x:Name="IconsPage" Header="{DynamicResource Settings.Page.Icons}">
                <ScrollViewer Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Settings.Icons.Title}" />

                        <!-- As on the Appearance page: why the shadows' card is greyed, said at
                             full strength rather than inside the card it is about. -->
                        <TextBlock
                            x:Name="NoGpuIconsNote"
                            Margin="2,0,0,8"
                            Style="{StaticResource Hint}"
                            Text="{DynamicResource Settings.Icons.NoGpu.Note}"
                            Visibility="Collapsed" />

                        <!-- The list is read again whenever this window comes back to the front,
                             so a set copied in with Open folder shows up without reopening
                             anything. -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Settings.Icons.IconSet}" />
                                        <TextBlock
                                            Style="{StaticResource CardHint}"
                                            Text="{DynamicResource Settings.Icons.IconSet.Hint}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <ComboBox x:Name="IconSetBox" AutomationProperties.Name="{DynamicResource Settings.Icons.IconSet}" AutomationProperties.HelpText="{DynamicResource Settings.Icons.IconSet.Hint}" MinWidth="200" />
                                        <Button
                                            x:Name="IconSetFolderButton"
                                            Margin="8,0,0,0"
                                            Content="{DynamicResource Common.OpenFolder}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    x:Name="IconSetProblems"
                                    Margin="0,8,0,0"
                                    Style="{StaticResource CardHint}"
                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="IconShadowsCard" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Settings.Icons.Shadows}" />
                                    <TextBlock
                                        Style="{StaticResource CardHint}"
                                        Text="{DynamicResource Settings.Icons.Shadows.Hint}" />
                                </StackPanel>
                                <CheckBox
                                    x:Name="IconShadowsCheck"
                                    AutomationProperties.Name="{DynamicResource Settings.Icons.Shadows}"
                                    AutomationProperties.HelpText="{DynamicResource Settings.Icons.Shadows.Hint}"
                                    Grid.Column="1"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- The labels' lettering, one card for the face and the size together:
                             they describe the same bubble. The two lists are a fixed width,
                             because a list as wide as its widest entry would jump once the
                             typefaces had been opened — some of their names are long. -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Settings.Icons.LabelFont}" />
                                        <TextBlock
                                            Style="{StaticResource CardHint}"
                                            Text="{DynamicResource Settings.Icons.LabelFont.Hint}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <ComboBox
                                            x:Name="LabelFontBox"
                                            AutomationProperties.Name="{DynamicResource Settings.Icons.LabelFont}"
                                            AutomationProperties.HelpText="{DynamicResource Settings.Icons.LabelFont.Hint}"
                                            Width="200"
                                            MaxDropDownHeight="260" />
                                        <ComboBox
                                            x:Name="LabelStyleBox"
                                            AutomationProperties.Name="{DynamicResource Settings.Icons.LabelStyle}"
                                            Width="130"
                                            Margin="8,0,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="{StaticResource ReadoutWidth}" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource Settings.Icons.LabelSize}" />
                                    <Slider
                                        x:Name="LabelSizeSlider"
                                        AutomationProperties.Name="{DynamicResource Settings.Icons.LabelSize}"
                                        Grid.Column="1"
                                        Style="{StaticResource RowSlider}"
                                        Maximum="28"
                                        Minimum="8"
                                        TickFrequency="1" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource RowValue}"
                                        loc:Localized.Key="Settings.Icons.LabelSize.Value"
                                        loc:Localized.Value="{Binding ElementName=LabelSizeSlider, Path=Value}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button
                            x:Name="ResetIconsButton"
                            Style="{StaticResource PageReset}"
                            Content="{DynamicResource Settings.Icons.Reset}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== ITEMS ==================== -->
            <!-- Named so the code can tell when it is open: the row selected here is held up on
                 the dock, but only while this page is the one being looked at. -->
            <TabItem x:Name="ItemsPage" Header="{DynamicResource Settings.Page.Items}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.ColumnSpan="2"
                        Style="{StaticResource PageTitle}"
                        Text="{DynamicResource Settings.Items.Title}" />

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                        <!-- The lock reaches the rows through the Tag: a DataTemplate has a
                             namescope of its own, so an ElementName binding to the checkbox
                             cannot be written inside one. Here, outside the template, it can. -->
                        <ListBox
                            x:Name="PinnedList"
                            AutomationProperties.Name="{DynamicResource Settings.Items.Title}"
                            AllowDrop="True"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalContentAlignment="Stretch"
                            Tag="{Binding IsChecked, ElementName=LockOrderCheck}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:AnimatedRowPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <!-- What a screen reader calls a row. A row holds a pin, not a string,
                                 and unnamed it was read as the pin's type,
                                 ArtDock.Services.PinnedAppSetting. -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                            <Setter Property="AutomationProperties.Name" Value="{DynamicResource Preset.Separator}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Faded while the order is locked. The grip is the
                                             row's one invitation to drag it, and an
                                             invitation that is not being honoured is worse
                                             than none. -->
                                        <Path
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            Data="{StaticResource GripDots}"
                                            Fill="{DynamicResource TextFillColorTertiaryBrush}">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                            <Setter Property="Opacity" Value="0.3" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <!-- Every row shows the icon the dock draws its item
                                             with — from the set chosen on the Icons page,
                                             and a folder in its own colour and symbol if it has
                                             been customized — so an item is found here as it is
                                             on the dock, by its icon before its name. Shrunk
                                             from 128, so high quality, or its edges come out in
                                             steps. -->
                                        <Image
                                            x:Name="ItemIcon"
                                            Grid.Column="1"
                                            Width="20"
                                            Height="20"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Source>
                                                <MultiBinding Converter="{StaticResource ItemRowIcon}">
                                                    <Binding />
                                                    <Binding Path="(views:ItemRowIconConverter.IconSet)" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                                </MultiBinding>
                                            </Image.Source>
                                        </Image>
                                        <TextBlock
                                            x:Name="ItemLabel"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Text="{Binding Label}"
                                            TextTrimming="CharacterEllipsis" />

                                        <!-- A pin that opens a folder is marked at the row's far
                                             end: the pins the item editor offers to draw as a
                                             folder. The icon alone does not always say so — a
                                             folder drawn in a colour of its own, or by an icon
                                             set, reads first as that colour or that picture. In
                                             the theme's symbol font and at the size of the menus'
                                             glyphs; the right margin is the separator rule's, so
                                             the two end in line. -->
                                        <TextBlock
                                            x:Name="FolderMark"
                                            Grid.Column="3"
                                            Margin="12,0,8,0"
                                            VerticalAlignment="Center"
                                            FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                            FontSize="16"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{x:Static views:FolderRowMarkConverter.Glyph}"
                                            Visibility="{Binding Converter={StaticResource FolderRowMark}}" />

                                        <!-- A separator is punctuation rather than an entry,
                                             and the row says so the way the dock does: it
                                             draws the rule instead of spelling out a name
                                             that would sit in the list looking like an app
                                             called Separator. -->
                                        <Border
                                            x:Name="SeparatorRule"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Height="2"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource TextFillColorTertiaryBrush}"
                                            CornerRadius="1"
                                            Visibility="Collapsed" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                            <Setter TargetName="ItemLabel" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="SeparatorRule" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="12,0,0,4">
                        <!-- The dropdown is built in code from the same list the dock's own
                             right-click menu uses, so the two cannot drift apart. -->
                        <Button
                            x:Name="AddButton"
                            Margin="0,0,0,8"
                            MinWidth="132"
                            Style="{StaticResource GlyphButton}"
                            views:MenuIcons.Glyph="Add"
                            Content="{DynamicResource Settings.Items.Add}" />

                        <!-- Add works on the list; everything below it works on whichever
                             item is selected, and is dead until one is. Ruled apart so the
                             one button that is always available does not read as the odd
                             one out of five that happen to be greyed. -->
                        <Border
                            Height="1"
                            Margin="4,4,4,12"
                            Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                        <Button
                            x:Name="ItemSettingsButton"
                            Margin="0,0,0,8"
                            MinWidth="132"
                            Style="{StaticResource GlyphButton}"
                            views:MenuIcons.Glyph="Edit"
                            Content="{DynamicResource Settings.Items.ItemSettings}" />
                        <Button
                            x:Name="RemoveButton"
                            Margin="0,0,0,8"
                            MinWidth="132"
                            Style="{StaticResource DangerGlyphButton}"
                            views:MenuIcons.Glyph="Unpin"
                            Content="{DynamicResource Common.Remove}" />
                        <Button
                            x:Name="MoveUpButton"
                            Margin="0,0,0,8"
                            MinWidth="132"
                            Style="{StaticResource GlyphButton}"
                            views:MenuIcons.Glyph="MoveUp"
                            Content="{DynamicResource Settings.Items.MoveUp}" />
                        <Button
                            x:Name="MoveDownButton"
                            MinWidth="132"
                            Style="{StaticResource GlyphButton}"
                            views:MenuIcons.Glyph="MoveDown"
                            Content="{DynamicResource Settings.Items.MoveDown}" />

                        <!-- Not a page reset like the other pages carry. What a page reset
                             would offer here is the starting set, and that comes back with the
                             whole-application reset on About; this page's own offer is starting
                             again from nothing. -->
                        <Button
                            x:Name="ClearItemsButton"
                            Margin="0,20,0,0"
                            MinWidth="132"
                            Style="{StaticResource DangerGlyphButton}"
                            views:MenuIcons.Glyph="ClearAll"
                            Content="{DynamicResource Settings.Items.ClearAll}" />
                    </StackPanel>

                    <!-- Column 0 only, so neither the checkbox nor the hint runs under the
                         button column beside the list. -->
                    <StackPanel Grid.Row="2" Margin="2,10,0,0">
                        <CheckBox
                            x:Name="LockOrderCheck"
                            Content="{DynamicResource Settings.Items.LockOrder}"
                            ToolTip="{DynamicResource Settings.Items.LockOrder.Tip}" />

                        <!-- The other half of the same idea: one fixes the arrangement of a
                             list that is still open, this one closes the list. Both, and the
                             dock is exactly as it stands. -->
                        <CheckBox
                            x:Name="LockContentsCheck"
                            Margin="0,8,0,0"
                            Content="{DynamicResource Settings.Items.LockContents}"
                            ToolTip="{DynamicResource Settings.Items.LockContents.Tip}" />

                        <!-- Named because it has two readings: an order that cannot be
                             dragged makes a hint about dragging to reorder a lie. -->
                        <TextBlock
                            x:Name="ItemsHint"
                            Margin="0,8,0,0"
                            Style="{StaticResource Hint}"
                            Text="{DynamicResource Settings.Items.Hint.Reorder}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ==================== HOTKEYS ==================== -->
            <!-- Called Hotkeys, after what is set on it, and not Shortcuts, which is what Windows
                 calls these and what the dock calls half the things pinned to it; it was Keyboard
                 for its first day, until 2026-10-02. Below Items, since most of its keys open
                 them; it stood below Behaviour until the same day. Each row's box records while
                 it has the keyboard (Controls/HotkeyRecorder), and each part of a row is found by
                 the action's name — KeyboardHotkey, KeyboardHotkeyClear, KeyboardHotkeyStatus —
                 so a row added here is a row the code finds. While a box records, the dock lets
                 its hotkeys go, or pressing the one being changed would fire it. -->
            <TabItem x:Name="HotkeysPage" Header="{DynamicResource Settings.Page.Hotkeys}">
                <!-- Focusable, and so the first place on the page to take the keyboard: a click
                     on a page's tab, with the keyboard anywhere but on another tab, hands it to the
                     first control on the page (TabItem does it, through PART_SelectedContentHost),
                     and here that was the first box, which records while it has the keyboard — the
                     dock letting its hotkeys go meanwhile. The page has it instead; Tab goes on to
                     the boxes, and a click on the page away from them takes it back out of one. -->
                <ScrollViewer
                    Padding="0,0,12,0"
                    Focusable="True"
                    IsTabStop="True"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Settings.Hotkeys.Title}" />

                        <TextBlock
                            Margin="2,0,0,12"
                            Style="{StaticResource Hint}"
                            Text="{DynamicResource Settings.Hotkeys.Hint}" />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
