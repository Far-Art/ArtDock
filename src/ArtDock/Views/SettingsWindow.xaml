                </ScrollViewer>
            </TabItem>

            <!-- ==================== EXCLUSIONS ==================== -->
            <!-- After Items and their hotkeys, because it is the other list of programs the user
                 keeps, though what it qualifies is Behaviour and Hotkeys: the edge the first
                 describes does nothing over the programs listed here while they fill the screen,
                 and the hotkeys are let go of while one is in front at all. Called Exclusions
                 rather than Fullscreen, which read as a setting for going fullscreen. No page
                 reset — the list is the user's own, like the pinned items, and Remove is how
                 an entry goes. -->
            <TabItem x:Name="ExclusionsPage" Header="{DynamicResource Settings.Page.Exclusions}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.ColumnSpan="2"
                        Style="{StaticResource PageTitle}"
                        Text="{DynamicResource Settings.Exclusions.Title}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="2,0,0,12"
                        Style="{StaticResource Hint}"
                        Text="{DynamicResource Settings.Exclusions.Hint}" />

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
                        <Grid>
                            <!-- Two lines to a row beside the program's icon: what it calls
                                 itself, and where it is — the name alone cannot tell two builds
                                 of a game apart. -->
                            <ListBox
                                x:Name="NoRevealList"
                                AutomationProperties.Name="{DynamicResource Settings.Exclusions.Title}"
                                AutomationProperties.HelpText="{DynamicResource Settings.Exclusions.Hint}"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Stretch"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <!-- Read as the row shows it: the program's name, and where it is
                                     as the help. Unnamed, a row was read as the record it holds. -->
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                        <Setter Property="AutomationProperties.HelpText" Value="{Binding Path}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Width="24"
                                                Height="24"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center"
                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                Source="{Binding Icon}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource CardHint}" Text="{Binding Path}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- An empty card does not explain itself, and empty is how the
                                 list starts. -->
                            <TextBlock
                                x:Name="NoRevealEmptyHint"
                                Margin="12,10,12,10"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False"
                                Style="{StaticResource Hint}"
                                Text="{DynamicResource Settings.Exclusions.Empty}" />
                        </Grid>
                    </Border>

                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="12,0,0,4">
                        <!-- A dropdown, like the Items page's Add: the programs open right now,
                             then Browse… for one that is not. Built when it opens, so a game
                             started with this window already open is in it. -->
                        <Button
                            x:Name="NoRevealAddButton"
                            Margin="0,0,0,8"
                            MinWidth="132"
                            Content="{DynamicResource Settings.Exclusions.Add}" />

                        <!-- For the program nobody knows the name of, because a launcher starts
                             it: finds the launchers' games by itself, and a game can be ticked
                             whole. -->
                        <Button
                            x:Name="NoRevealScanButton"
                            Margin="0,0,0,8"
                            MinWidth="132"
                            Content="{DynamicResource Settings.Exclusions.Scan}" />

                        <!-- The same, for everything that is not a game: a video player, a
                             browser, a remote desktop — the apps that go fullscreen too. -->
                        <Button
                            x:Name="NoRevealScanAppsButton"
                            Margin="0,0,0,8"
                            MinWidth="132"
                            Content="{DynamicResource Settings.Exclusions.ScanApps}" />
                        <Button
                            x:Name="NoRevealRemoveButton"
                            MinWidth="132"
                            Style="{StaticResource DangerButton}"
                            Content="{DynamicResource Common.Remove}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Row="3"
                        Margin="2,10,0,0"
                        Style="{StaticResource Hint}"
                        Text="{DynamicResource Settings.Exclusions.Matching}" />
                </Grid>
            </TabItem>

            <!-- ==================== POSITION ==================== -->
            <TabItem x:Name="PositionPage" Header="{DynamicResource Settings.Page.Position}">
                <ScrollViewer Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Settings.Position.Title}" />

                        <!-- Where along the bottom edge. There is no choice of edge: the bottom
                             is the only one built, and a card offering left and right greyed out
                             was a control nobody could use. It comes back with the side edges. -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="{StaticResource ReadoutWidth}" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Settings.Position.AlongEdge}" />
                                    <TextBlock
                                        Style="{StaticResource CardHint}"
                                        Text="{DynamicResource Settings.Position.AlongEdge.Hint}" />
                                </StackPanel>
                                <!-- Filled from the middle rather than from the left, because the
                                     setting is two-sided. The selection range is what draws that:
                                     code keeps it between the middle and the value. -->
                                <!-- Left to right whatever the language: the ends are the ends of
                                     the screen, not the start and end of a line of text. -->
                                <Slider
                                    x:Name="EdgeOffsetSlider"
                                    AutomationProperties.Name="{DynamicResource Settings.Position.AlongEdge}"
                                    AutomationProperties.HelpText="{DynamicResource Settings.Position.AlongEdge.Hint}"
                                    Grid.Column="1"
                                    FlowDirection="LeftToRight"
                                    Style="{StaticResource RowSlider}"
                                    IsSelectionRangeEnabled="True"
                                    Maximum="1"
                                    Minimum="-1"
                                    TickFrequency="0.01" />
                                <TextBlock
                                    x:Name="EdgeOffsetText"
                                    Grid.Column="2"
                                    Style="{StaticResource RowValue}" />
                            </Grid>
                        </Border>

                        <Border x:Name="ScreenCard" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Settings.Position.Display}" />
                                    <TextBlock
                                        x:Name="ScreenHint"
                                        Style="{StaticResource CardHint}"
                                        Text="{DynamicResource Settings.Position.Display.Hint}" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="ScreenBox"
                                    AutomationProperties.Name="{DynamicResource Settings.Position.Display}"
                                    AutomationProperties.HelpText="{DynamicResource Settings.Position.Display.Hint}"
                                    Grid.Column="1"
                                    MinWidth="230"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Button
                            x:Name="ResetPositionButton"
                            Style="{StaticResource PageReset}"
                            Content="{DynamicResource Settings.Position.Reset}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== SYSTEM ==================== -->
            <TabItem x:Name="SystemPage" Header="{DynamicResource Settings.Page.System}">
                <ScrollViewer Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Settings.System.Title}" />

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Settings.System.Theme}" />
                                    <TextBlock
                                        Style="{StaticResource CardHint}"
                                        Text="{DynamicResource Settings.System.Theme.Hint}" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="ThemeBox"
                                    AutomationProperties.Name="{DynamicResource Settings.System.Theme}"
                                    AutomationProperties.HelpText="{DynamicResource Settings.System.Theme.Hint}"
                                    Grid.Column="1"
                                    MinWidth="180"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Previewed like the theme: choosing a language changes these words
                             straight away, and Cancel puts the old ones back. -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Settings.System.Language}" />
                                        <TextBlock
                                            Style="{StaticResource CardHint}"
                                            Text="{DynamicResource Settings.System.Language.Hint}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <ComboBox x:Name="LanguageBox" AutomationProperties.Name="{DynamicResource Settings.System.Language}" AutomationProperties.HelpText="{DynamicResource Settings.System.Language.Hint}" MinWidth="200" />
                                        <Button
                                            x:Name="LanguageFolderButton"
                                            Margin="8,0,0,0"
                                            Content="{DynamicResource Common.OpenFolder}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    x:Name="LanguageProblems"
                                    Margin="0,8,0,0"
                                    Style="{StaticResource CardHint}"
                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource Settings.System.RunAtLogin}" />
                                <CheckBox
                                    x:Name="RunAtLoginCheck"
                                    AutomationProperties.Name="{DynamicResource Settings.System.RunAtLogin}"
                                    Grid.Column="1"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Settings.System.ReduceMotion}" />
                                    <TextBlock
                                        Style="{StaticResource CardHint}"
                                        Text="{DynamicResource Settings.System.ReduceMotion.Hint}" />
                                </StackPanel>
                                <CheckBox
                                    x:Name="ReduceMotionCheck"
                                    AutomationProperties.Name="{DynamicResource Settings.System.ReduceMotion}"
                                    AutomationProperties.HelpText="{DynamicResource Settings.System.ReduceMotion.Hint}"
                                    Grid.Column="1"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- For a machine with nothing but the processor to draw with. The dock
                             ticks this for itself once only, on a first run where WPF reports
                             no hardware to draw with, and says so then; after that the line
                             under it only says when that is so and the box is not ticked.

                             In Windows' own caution colours, the ones its warning bars are
                             drawn in, and the only card that is: ticking it takes the blur, the
                             bar's opacity and the dialog's material away, and it should not be
                             ticked in passing. The theme's keys, so it follows light and dark. -->
                        <Border
                            Style="{StaticResource Card}"
                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            BorderBrush="{DynamicResource SystemFillColorCautionBrush}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Settings.System.NoGpu}" />
                                        <TextBlock
                                            Style="{StaticResource CardHint}"
                                            Text="{DynamicResource Settings.System.NoGpu.Hint}" />
                                    </StackPanel>
                                    <CheckBox
                                        x:Name="NoGpuCheck"
                                        AutomationProperties.Name="{DynamicResource Settings.System.NoGpu}"
                                        AutomationProperties.HelpText="{DynamicResource Settings.System.NoGpu.Hint}"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock
                                    x:Name="NoGpuDetected"
                                    Margin="0,8,0,0"
                                    Style="{StaticResource CardHint}"
                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                    Text="{DynamicResource Settings.System.NoGpu.Detected}"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Button
                            x:Name="ResetSystemButton"
                            Style="{StaticResource PageReset}"
                            Content="{DynamicResource Settings.System.Reset}" />

                        <!-- Import and export are about the settings file as a whole rather
                             than about one setting, so they are a card of their own, set apart
                             from the page reset above. Import goes through the same
                             preview-then-Save path as every other control here, which is what
                             the hint promises. -->
                        <Border Style="{StaticResource Card}" Margin="0,20,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Settings.System.SettingsFile}" />
                                    <TextBlock
                                        Style="{StaticResource CardHint}"
                                        Text="{DynamicResource Settings.System.SettingsFile.Hint}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Button
                                        x:Name="ImportButton"
                                        MinWidth="92"
                                        Margin="0,0,8,0"
                                        Content="{DynamicResource Settings.System.Import}" />
                                    <Button
                                        x:Name="ExportButton"
                                        MinWidth="92"
                                        Content="{DynamicResource Settings.System.Export}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== ABOUT ==================== -->
            <!-- Last, because it is the one page with nothing on it to set, and so no page reset
                 — only the whole-application one, which is about every page rather than this.
                 Where a page stands here is not its number in SettingsPage, which is stored and
                 kept in the code-behind's list of pages: a page can be put anywhere here
                 without reopening the dialog one page off for everyone. The build
                 configuration is called out deliberately: the dock that runs here is the
                 Release one, and "this fix did not work" has more than once turned out to be a
                 Debug binary. -->
            <TabItem x:Name="AboutPage" Header="{DynamicResource Settings.Page.About}">
                <ScrollViewer Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Settings.About.Title}" />

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- 128 because the .ico has that frame for 100%, and 256 to
                                     come down from at 150% — see ShowLogo. Big enough for the
                                     mark's glass tray and highlight to show, which the small
                                     frames lose, and about the height of the text beside it. -->
                                <Image
                                    x:Name="AboutLogo"
                                    Width="128"
                                    Height="128"
                                    Margin="0,0,24,0"
                                    VerticalAlignment="Center"
                                    RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Text="ArtDock" />
                                    <TextBlock
                                        x:Name="AboutTaglineText"
                                        Style="{StaticResource CardHint}"
                                        Text="{DynamicResource Settings.About.Tagline}" />
                                    <TextBlock
                                        x:Name="AboutCopyrightText"
                                        Style="{StaticResource CardHint}" />
                                    <TextBlock
                                        x:Name="AboutVersionText"
                                        Margin="0,8,0,0"
                                        Style="{StaticResource CardHint}" />
                                    <TextBlock
                                        x:Name="AboutRuntimeText"
                                        Style="{StaticResource CardHint}" />
                                    <TextBlock
                                        x:Name="SettingsPathText"
                                        Margin="0,8,0,0"
                                        Style="{StaticResource CardHint}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Updates, from the public releases repository by Velopack — see
                             Services/AppUpdater.cs. One button that is first Check and then
                             Update and restart, for the version the check found, so nothing is
                             fetched or applied without a press for it. A copy the setup did not
                             install — a build run from the source tree — says so and offers
                             nothing, because it has no installation to update. -->
                        <Border Style="{StaticResource Card}" Margin="0,20,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Settings.About.Updates}" />
                                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource CardHint}" />
                                </StackPanel>
                                <Button
                                    x:Name="UpdateButton"
                                    Grid.Column="1"
                                    MinWidth="190"
                                    VerticalAlignment="Center"
                                    Content="{DynamicResource Settings.About.Updates.Check}" />
                            </Grid>
                        </Border>

                        <!-- The whole-application reset lives here rather than on any one
                             page, because it is about all of them — and on a page with no page
                             reset of its own, so it cannot be mistaken for one. It says what it
                             leaves alone, and that the pinned items are not among it — and is
                             red like Remove and Clear all, because it takes the user's items
                             off the dock as they do. -->
                        <Border Style="{StaticResource Card}" Margin="0,4,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Settings.About.StartOver}" />
                                    <TextBlock
                                        Style="{StaticResource CardHint}"
                                        Text="{DynamicResource Settings.About.StartOver.Hint}" />
                                </StackPanel>
                                <Button
                                    x:Name="ResetButton"
                                    Grid.Column="1"
                                    MinWidth="190"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource DangerButton}"
                                    Content="{DynamicResource Settings.About.StartOver.Button}" />
                            </Grid>
                        </Border>

                        <!-- The tray menu has an Exit too, but Windows 11 tucks new tray icons
                             behind the overflow arrow, and the dock's own menu has no Exit — only
                             Dock settings…, which leads here. On this page because, like the rest
                             of it, it is about the application rather than a setting of it.
                             Unsaved changes go the way Cancel sends them, without asking, since
                             nothing else in this dialog asks either; the hint says so instead. -->
                        <Border Style="{StaticResource Card}" Margin="0,4,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Common.ExitArtDock}" />
                                    <TextBlock
                                        Style="{StaticResource CardHint}"
                                        Text="{DynamicResource Settings.About.Exit.Hint}" />
                                </StackPanel>
                                <Button
                                    x:Name="ExitButton"
                                    Grid.Column="1"
                                    MinWidth="92"
                                    VerticalAlignment="Center"
                                    Content="{DynamicResource Common.Exit}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel
            Grid.Row="1"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <!-- Deliberately not IsCancel: that sets DialogResult, which throws on a window
                 shown with Show() rather than ShowDialog(). Escape is handled in code. -->
            <Button x:Name="CancelButton" Margin="0,0,8,0" MinWidth="96" Content="{DynamicResource Common.Cancel}" />
            <Button
                x:Name="SaveButton"
                MinWidth="96"
                Content="{DynamicResource Common.Save}"
                IsDefault="True"
                Style="{DynamicResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
